# OpenFEC API (https://api.open.fec.gov/developers/)
# Sign up at https://api.data.gov/signup/ for a free key
FEC_API_KEY=your_fec_api_key_here

# OpenStates API (https://openstates.org/accounts/profile/) — state legislators
OPENSTATES_API_KEY=your_openstates_key_here

# Google Cloud Console → enable "Google Civic Information API" → create API key
GOOGLE_CIVIC_API_KEY=your_key_here

# Optional future: Census ACS
# CENSUS_API_KEY=
